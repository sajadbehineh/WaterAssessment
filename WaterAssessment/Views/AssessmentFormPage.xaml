<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WaterAssessment.Views.AssessmentFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:akTools="using:AK.Toolkit.WinUI3"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WaterAssessment.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WaterAssessment.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WaterAssessment.Models"
    xmlns:viewModels="using:WaterAssessment.ViewModel"
    x:Name="MyPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    DataContext="{x:Bind ViewModel}"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource SamimFD}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="akTools:NumberBoxEx">
            <Setter Property="IsDeleteButtonVisible" Value="False" />
            <Setter Property="NumberHorizontalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>
    <Grid>
        <controls:SwitchPresenter
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            TargetType="x:Boolean"
            Value="{x:Bind IsPageLoading, Mode=OneWay}">
            <controls:Case Value="True">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="8">
                    <ProgressRing IsActive="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource SamimMedium}"
                        FontWeight="Normal"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="در حال بارگذاری اطلاعات فرم..." />
                </StackPanel>
            </controls:Case>
            <controls:Case Value="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="InputsPanel"
                        Grid.Row="0"
                        Width="1054.5"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="Black"
                        BorderThickness="1,1,1,0"
                        CornerRadius="4 4 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="محل اندازه گیری" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                CornerRadius="0"
                                DisplayMemberPath="LocationName"
                                ItemsSource="{x:Bind ViewModel.AllLocations}"
                                MaxDropDownHeight="300"
                                PlaceholderText="انتخاب کنید..."
                                SelectedItem="{x:Bind ViewModel.SelectedLocation, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="0,1,0,1">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="تاریخ اندازه گیری" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,1,0,1">
                            <CalendarDatePicker
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                BorderThickness="0"
                                CalendarIdentifier="PersianCalendar"
                                CornerRadius="0"
                                Date="{x:Bind ViewModel.Date, Mode=TwoWay, Converter={StaticResource DateToOffsetConv}}"
                                DateFormat="{}{year.full}/{month.integer}/{day.integer}"
                                Language="fa-IR" />
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="پروانه" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                CornerRadius="0"
                                DisplayMemberPath="PropellerName"
                                IsEnabled="{x:Bind ViewModel.IsHydrometryForm, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.AllPropellers}"
                                MaxDropDownHeight="300"
                                PlaceholderText="انتخاب کنید..."
                                SelectedItem="{x:Bind ViewModel.SelectedPropeller, Mode=TwoWay}" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,1,0,1">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="اشل (m)" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="3"
                            BorderBrush="Black"
                            BorderThickness="1,1,0,1">
                            <akTools:NumberBoxEx
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                BorderThickness="0"
                                NumberFormatter="{StaticResource Df}"
                                PlaceholderText="مثلا 116.20"
                                Value="{x:Bind ViewModel.Echelon, Mode=TwoWay, Converter={StaticResource NullDoubleConv}}" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,1">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="اندازه گیرها" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,1">
                            <StackPanel
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        MinWidth="260"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="LastName"
                                        ItemsSource="{x:Bind ViewModel.AllEmployees}"
                                        MaxDropDownHeight="300"
                                        SelectedItem="{x:Bind ViewModel.SelectedEmployeeToAdd, Mode=TwoWay}" />
                                    <Button
                                        Height="33"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{x:Bind ViewModel.AddEmployeeCommand}"
                                        Content="+" />
                                </StackPanel>

                                <ItemsControl VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.AssessmentEmployees}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Assessment_Employee">
                                            <Border
                                                Padding="8,2"
                                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                                BorderBrush="DimGray"
                                                BorderThickness="0.5"
                                                CornerRadius="4">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch"
                                                        Text="{x:Bind Employee.LastName}" />
                                                    <Button
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding ElementName=MyPage, Path=DataContext.RemoveEmployeeCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        FontSize="10"
                                                        Foreground="Red" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <TextBlock
                                Padding="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="تایمر" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="3"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <akTools:NumberBoxEx
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.IsHydrometryForm, Mode=OneWay}"
                                SmallChange="10"
                                Value="{x:Bind ViewModel.Timer, Mode=TwoWay}" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="مولینه" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="3"
                            BorderBrush="Black"
                            BorderThickness="1,0,0,0">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                CornerRadius="0"
                                DisplayMemberPath="CurrentMeterName"
                                IsEnabled="{x:Bind ViewModel.IsHydrometryForm, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.AllCurrentMeters}"
                                MaxDropDownHeight="300"
                                PlaceholderText="انتخاب کنید..."
                                SelectedItem="{x:Bind ViewModel.SelectedCurrentMeter, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="4"
                            BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                            BorderThickness="1,0,0,0">
                            <TextBlock
                                Padding="0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                HorizontalTextAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="دبی کل&#x0a;(m3/s)" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="5"
                            BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                            BorderThickness="1,0,0,0">
                            <Grid>
                                <TextBlock
                                    x:Name="TotalFlowBox"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="Green"
                                    Text="{x:Bind ViewModel.TotalFlowDisplay, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsNotManualForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <akTools:NumberBoxEx
                                    Padding="130,3,0,0"
                                    HorizontalAlignment="Stretch"
                                    FontSize="20"
                                    Foreground="Green"
                                    IsDeleteButtonVisible="True"
                                    Visibility="{x:Bind ViewModel.IsManualForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Value="{x:Bind ViewModel.ManualTotalFlowInput, Mode=TwoWay}">
                                    <akTools:NumberBoxEx.NumberFormatter>
                                        <helpers:FlexibleDoubleFormatter Decimals="3" />
                                    </akTools:NumberBoxEx.NumberFormatter>
                                </akTools:NumberBoxEx>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Width="1054.5"
                        HorizontalAlignment="Stretch"
                        Spacing="0">
                        <Grid
                            HorizontalAlignment="Stretch"
                            BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                            BorderThickness="1,0,1,0"
                            CornerRadius="0"
                            Visibility="{x:Bind ViewModel.IsNotDischargeEquationForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander
                                Margin="0"
                                Padding="0,8,0,2"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                CornerRadius="0"
                                Header="گشودگی‌های اندازه‌گیری"
                                IsExpanded="True"
                                Visibility="{x:Bind ViewModel.HasGates, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="0" Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource SamimMedium}"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Text="درصد گشودگی هر دریچه در زمان اندازه‌گیری" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.GateValues, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalSpacing="1"
                                                    VerticalSpacing="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AssessmentGate">
                                                <Border Padding="10,8" CornerRadius="6">
                                                    <StackPanel
                                                        Width="85"
                                                        HorizontalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontFamily="{StaticResource SamimFD}"
                                                            FontSize="12"
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{x:Bind GateNumber}" />
                                                        <akTools:NumberBoxEx
                                                            Height="32"
                                                            HorizontalAlignment="Stretch"
                                                            BorderThickness="1"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            NumberFormatter="{StaticResource Df}"
                                                            PlaceholderText="%"
                                                            Value="{x:Bind Value, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Grid>

                        <Grid
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="0"
                            Visibility="{x:Bind ViewModel.HasPumps, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                CornerRadius="0"
                                Header="وضعیت پمپ ها"
                                IsExpanded="True">
                                <StackPanel>
                                    <TextBlock
                                        Margin="4,0,0,6"
                                        FontFamily="{StaticResource SamimMedium}"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Text="پمپ‌های روشن در زمان اندازه گیری" />
                                    <ScrollViewer
                                        MaxHeight="110"
                                        HorizontalAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.PumpStates, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WrapPanel
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalSpacing="0"
                                                        Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AssessmentPump">
                                                    <CheckBox
                                                        MinWidth="100"
                                                        Content="{x:Bind LocationPump.PumpName, Mode=OneWay}"
                                                        FontFamily="{StaticResource SamimFD}"
                                                        IsChecked="{x:Bind IsRunning, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </StackPanel>
                    <Rectangle
                        Grid.Row="2"
                        Width="1054.5"
                        Height="1"
                        VerticalAlignment="Top"
                        Fill="Black"
                        Visibility="{x:Bind ViewModel.IsManualForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid
                        Grid.Row="2"
                        Width="1054.5"
                        MinHeight="48"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{x:Bind ViewModel.IsHydrometryForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="ردیف" />
                        <Rectangle
                            Grid.Column="0"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="فاصله" />
                        <Rectangle
                            Grid.Column="1"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="عمق" />
                        <Rectangle
                            Grid.Column="2"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <Grid
                            Grid.Row="0"
                            Grid.Column="3"
                            HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="0"
                                BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemAltHighColor}"
                                    Text="تعداد دور /  ثانیه" />
                            </Border>
                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal">
                                <Border
                                    Width="88"
                                    BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                    BorderThickness="0,0,1,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemAltHighColor}"
                                        Text="{x:Bind ViewModel.Timer, Mode=TwoWay}" />
                                </Border>
                                <Border
                                    Width="88"
                                    BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                    BorderThickness="0,0,1,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemAltHighColor}"
                                        Text="یک" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid
                            Grid.Column="4"
                            Width="Auto"
                            HorizontalAlignment="Right">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="0"
                                BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                BorderThickness="0,0,1,1">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemAltHighColor}"
                                    Text="سرعت متوسط در" />
                            </Border>
                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal">
                                <Border
                                    Width="88"
                                    BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                    BorderThickness="0,0,1,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemAltHighColor}"
                                        Text="نقطه" />
                                </Border>
                                <Border
                                    Width="88"
                                    BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                    BorderThickness="0,0,1,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemAltHighColor}"
                                        Text="قائم" />
                                </Border>
                                <Border
                                    Width="88"
                                    BorderBrush="{ThemeResource SystemChromeBlackHighColor}"
                                    BorderThickness="0,0,1,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemAltHighColor}"
                                        Text="مقطع" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Column="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="عمق مقطع" />
                        <Rectangle
                            Grid.Column="5"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <TextBlock
                            Grid.Column="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="عرض مقطع" />
                        <Rectangle
                            Grid.Column="6"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <TextBlock
                            Grid.Column="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="سطح مقطع" />
                        <Rectangle
                            Grid.Column="7"
                            Width="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemChromeBlackHighColor}" />
                        <TextBlock
                            Grid.Column="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemAltHighColor}"
                            Text="دبی مقطع" />
                    </Grid>
                    <ScrollViewer
                        x:Name="HydrometryRowsScrollViewer"
                        Grid.Row="4"
                        Width="1055"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsHydrometryForm, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
