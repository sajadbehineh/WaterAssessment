<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WaterAssessment.Views.LocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aKTools="using:AK.Toolkit.WinUI3"
    xmlns:converters="using:WaterAssessment.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WaterAssessment.Helpers"
    xmlns:localControls="using:WaterAssessment.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WaterAssessment.Models"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:toolkitGrid="using:CommunityToolkit.WinUI.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource ContentControlThemeFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CenterCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <TabView IsAddTabButtonVisible="False" SelectedIndex="0">
        <TabViewItem
            x:Name="LocationTab"
            DataContext="{x:Bind LocationViewModel}"
            Header="ثبت اطلاعات محل های اندازه گیری"
            IsClosable="False">
            <TabViewItem.Resources>
                <converters:RowIndexConverter
                    x:Key="RowIndexConverter"
                    CurrentPage="{x:Bind LocationViewModel.CurrentPage, Mode=OneWay}"
                    ItemsSource="{x:Bind LocationViewModel.Locations, Mode=OneWay}"
                    PageSize="5" />
            </TabViewItem.Resources>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition
                            Width="*"
                            MinWidth="390"
                            MaxWidth="390" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        MaxWidth="400"
                        Margin="20,10"
                        HorizontalAlignment="Stretch"
                        Orientation="Vertical"
                        Spacing="20">
                        <StackPanel.Resources>
                            <helpers:DoubleFormatter x:Key="Df" />
                        </StackPanel.Resources>
                        <TextBox
                            Name="LocationBox"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Header="مکان اندازه گیری"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="لطفاً نام مکان اندازه گیری را وارد کنید"
                            Text="{x:Bind LocationViewModel.LocationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Name="CmbArea"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DisplayMemberPath="AreaName"
                            FontFamily="{StaticResource SamimFD}"
                            Header="حوزه اندازه گیری"
                            ItemsSource="{x:Bind LocationViewModel.Areas, Mode=OneWay}"
                            PlaceholderText="لطفاً حوزه مورد نظر را انتخاب کنید"
                            SelectedItem="{x:Bind LocationViewModel.SelectedArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Title"
                            FontFamily="{StaticResource SamimFD}"
                            Header="نوع مکان"
                            ItemsSource="{x:Bind LocationViewModel.LocationTypes, Mode=OneWay}"
                            PlaceholderText="انتخاب کنید..."
                            SelectedItem="{x:Bind LocationViewModel.SelectedLocationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox
                            HorizontalAlignment="Stretch"
                            FontFamily="{StaticResource SamimFD}"
                            Header="فرم اندازه‌گیری"
                            ItemsSource="{x:Bind LocationViewModel.AvailableFormTypes, Mode=OneWay}"
                            SelectedItem="{x:Bind LocationViewModel.SelectedMeasurementFormType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,5,0,0">
                        <CheckBox
                            Margin="0,0,0,10"
                            Content="دارای ایستگاه پمپاژ"
                            IsChecked="{x:Bind LocationViewModel.HasPump, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <aKTools:NumberBoxEx
                            Width="100"
                            HorizontalAlignment="Left"
                            Header="تعداد پمپ"
                            Maximum="30"
                            Minimum="0"
                            Visibility="{x:Bind LocationViewModel.HasPump, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Value="{x:Bind LocationViewModel.PumpCountDouble, Mode=TwoWay}" />
                        <Grid
                            Width="Auto"
                            Margin="0,15,1,0"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SystemAccentColor}"
                            BorderBrush="Black"
                            BorderThickness="1,1,1,0"
                            Visibility="{x:Bind LocationViewModel.HasPump, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="103" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemAltHighColor}"
                                Text="پمپ" />
                            <Rectangle
                                Grid.Column="0"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Fill="{ThemeResource SystemBaseHighColor}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemAltHighColor}"
                                Text="دبی اسمی (لیتر)" />
                        </Grid>

                        <ScrollViewer
                            Width="193"
                            MaxHeight="180"
                            Padding="0"
                            HorizontalAlignment="Left"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Visible"
                            VerticalScrollMode="Auto">
                            <ItemsControl ItemsSource="{x:Bind LocationViewModel.TempPumps, Mode=OneWay}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LocationPump">
                                        <StackPanel Margin="0,0,1,0" Orientation="Horizontal">
                                            <Border BorderBrush="Black" BorderThickness="1,0.5,0,1">
                                                <TextBlock
                                                    Width="77.5"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{x:Bind PumpName}" />
                                            </Border>
                                            <Border BorderBrush="Black" BorderThickness="1,0.5,1,1">
                                                <TextBox
                                                    Width="103"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    HorizontalTextAlignment="Center"
                                                    PlaceholderText="دبی اسمی"
                                                    Text="{x:Bind NominalFlow, Mode=TwoWay, Converter={StaticResource DoubleToStringConv}, ConverterParameter='N0'}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,5,0,0">
                        <aKTools:NumberBoxEx
                            Width="100"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Header="تعداد سکشن"
                            Visibility="{x:Bind LocationViewModel.SectionCountVisibility, Mode=OneWay}"
                            Value="{x:Bind LocationViewModel.SectionCountDouble, Mode=TwoWay}" />

                        <CheckBox
                            Margin="0,0,0,10"
                            Content="دارای دریچه تنظیم"
                            IsChecked="{x:Bind LocationViewModel.HasGate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <aKTools:NumberBoxEx
                            HorizontalAlignment="Left"
                            Header="تعداد گشودگی"
                            IsDeleteButtonVisible="False"
                            Maximum="30"
                            Minimum="0"
                            NumberHorizontalAlignment="Center"
                            SpinButtonPlacementMode="Inline"
                            Visibility="{x:Bind LocationViewModel.HasGate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Value="{x:Bind LocationViewModel.GateCountDouble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <aKTools:NumberBoxEx.NumberFormatter>
                                <helpers:FlexibleDoubleFormatter Decimals="0" />
                            </aKTools:NumberBoxEx.NumberFormatter>
                        </aKTools:NumberBoxEx>
                        <Grid
                            Width="Auto"
                            Margin="1,15,0,0"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SystemAccentColor}"
                            BorderBrush="Black"
                            BorderThickness="1,1,1,0"
                            Visibility="{x:Bind LocationViewModel.GateDischargeConfigVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemAltHighColor}"
                                Text="گشودگی" />
                            <Rectangle
                                Grid.Column="0"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Fill="{ThemeResource SystemBaseHighColor}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemAltHighColor}"
                                Text="ضریب (Cd)" />
                            <Rectangle
                                Grid.Column="1"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Fill="{ThemeResource SystemBaseHighColor}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemAltHighColor}"
                                Text="عرض L (m)" />
                        </Grid>

                        <ScrollViewer
                            Width="240"
                            MaxHeight="180"
                            Padding="0"
                            HorizontalAlignment="Left"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Visible"
                            VerticalScrollMode="Auto">
                            <ItemsControl
                                Margin="0"
                                Padding="1"
                                ItemsSource="{x:Bind LocationViewModel.TempHydraulicGates, Mode=OneWay}"
                                Visibility="{x:Bind LocationViewModel.GateDischargeConfigVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HydraulicGate">
                                        <StackPanel Margin="0" Orientation="Horizontal">
                                            <Border
                                                Margin="1,0,0,0"
                                                BorderBrush="Black"
                                                BorderThickness="1,0.5,1,1">
                                                <TextBlock
                                                    Width="67"
                                                    VerticalAlignment="Center"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{x:Bind GateNumber}" />
                                            </Border>
                                            <Border BorderBrush="Black" BorderThickness="0,0.5,1,1">
                                                <TextBox
                                                    Width="79"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{x:Bind DischargeCoefficient, Mode=TwoWay, Converter={StaticResource DoubleToStringConv}, ConverterParameter='F1'}" />
                                            </Border>
                                            <Border BorderBrush="Black" BorderThickness="0,0.5,1,1">
                                                <TextBox
                                                    Width="80"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{x:Bind Width, Mode=TwoWay, Converter={StaticResource DoubleToStringConv}}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>

                </Grid>
                <StackPanel
                    Grid.Row="1"
                    MinHeight="62"
                    Margin="20,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Name="BtnAddLocation"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind LocationViewModel.SaveLocationCommand}"
                        Content="{x:Bind LocationViewModel.AddEditBtnContent, Mode=OneWay}"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Name="BtnClearLocationBox"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind LocationViewModel.ClearFormCommand}"
                        Content="پاک کردن"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <InfoBar
                        x:Name="LocationInfoBar"
                        VerticalAlignment="Center"
                        IsClosable="True"
                        IsOpen="{x:Bind LocationViewModel.IsErrorVisible, Mode=TwoWay}"
                        Message="{x:Bind LocationViewModel.InfoBarMessage, Mode=OneWay}"
                        Severity="{x:Bind LocationViewModel.InfoBarSeverity, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Grid.Row="2"
                    MaxWidth="1100"
                    Margin="15,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0 0 32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <toolkitGrid:DataGrid
                            x:Name="LocationsGrid"
                            AutoGenerateColumns="False"
                            DataContext="{x:Bind LocationViewModel}"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsHitTestVisible="True"
                            IsReadOnly="True"
                            IsTabStop="False"
                            ItemsSource="{x:Bind LocationViewModel.Locations}"
                            SelectedItem="{x:Bind LocationViewModel.SelectedLocation, Mode=TwoWay}"
                            SelectionMode="Single">
                            <!--  Header Style  -->
                            <toolkitGrid:DataGrid.ColumnHeaderStyle>
                                <Style TargetType="primitives:DataGridColumnHeader">
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimMedium}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                                                <Grid Background="{ThemeResource SystemAccentColor}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Content="{TemplateBinding Content}"
                                                        Foreground="White" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </toolkitGrid:DataGrid.ColumnHeaderStyle>

                            <toolkitGrid:DataGrid.CellStyle>
                                <Style TargetType="toolkitGrid:DataGridCell">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimFD}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </toolkitGrid:DataGrid.CellStyle>

                            <!--  Row Style  -->
                            <toolkitGrid:DataGrid.RowStyle>
                                <Style TargetType="toolkitGrid:DataGridRow">
                                    <Setter Property="MinHeight" Value="44" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </toolkitGrid:DataGrid.RowStyle>

                            <toolkitGrid:DataGrid.Columns>

                                <!--  ردیف  -->
                                <toolkitGrid:DataGridTemplateColumn
                                    Width="SizeToCells"
                                    MinWidth="52"
                                    Header="ردیف">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding Converter={StaticResource RowIndexConverter}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <!--  مکان  -->
                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding LocationName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="مکان اندازه گیری" />

                                <!--  حوزه  -->
                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding Area.AreaName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="حوزه اندازه گیری" />

                                <!--  ویرایش کننده  -->
                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding UpdatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="آخرین ویرایش توسط" />

                                <!--  زمان ویرایش  -->
                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ویرایش">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding UpdatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <!--  ایجاد کننده  -->
                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding CreatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="ایجاد شده توسط" />

                                <!--  زمان ایجاد  -->
                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ایجاد">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding CreatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <!--  عملیات  -->
                                <toolkitGrid:DataGridTemplateColumn Width="90" Header="عملیات">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Location">
                                            <Button
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnLocationDeleteClick"
                                                DataContext="{Binding}">

                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="Red"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                            </toolkitGrid:DataGrid.Columns>

                        </toolkitGrid:DataGrid>

                        <!--  PAGINATION  -->
                        <localControls:PaginationControl
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            CurrentPage="{x:Bind LocationViewModel.CurrentPage, Mode=TwoWay}"
                            FlowDirection="LeftToRight"
                            PageChangedCommand="{x:Bind LocationViewModel.PageChangedCommand}"
                            PageSize="5"
                            TotalItemCount="{x:Bind LocationViewModel.TotalLocations}" />
                    </Grid>
                </Border>

            </Grid>
        </TabViewItem>

        <TabViewItem Header="ثبت حوزه های اندازه گیری" IsClosable="False">
            <TabViewItem.Resources>
                <converters:RowIndexConverter
                    x:Key="RowIndexConverter"
                    CurrentPage="{x:Bind AreaViewModel.CurrentPage, Mode=OneWay}"
                    ItemsSource="{x:Bind AreaViewModel.Areas, Mode=OneWay}"
                    PageSize="5" />
            </TabViewItem.Resources>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    MaxWidth="400"
                    Margin="20,10"
                    HorizontalAlignment="Left"
                    Orientation="Vertical"
                    Spacing="25">
                    <TextBox
                        Name="AreaNameBox"
                        MinWidth="300"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Header="نام حوزه"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="لطفاً نام حوزه مورد نظر را وارد کنید"
                        Text="{x:Bind AreaViewModel.AreaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Height="70"
                    Margin="20,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Name="BtnAddArea"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind AreaViewModel.AddAreaCommand}"
                        Content="{x:Bind AreaViewModel.AddEditBtnContent, Mode=OneWay}"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Name="BtnClearAreaBox"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind AreaViewModel.ClearFormCommand}"
                        Content="پاک کردن"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <InfoBar
                        x:Name="ShowErrorInfoBar"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsClosable="False"
                        IsOpen="{x:Bind AreaViewModel.IsErrorVisible, Mode=TwoWay}"
                        Message="{x:Bind AreaViewModel.InfoBarMessage, Mode=OneWay}"
                        Severity="{x:Bind AreaViewModel.InfoBarSeverity, Mode=OneWay}" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    MaxWidth="1100"
                    Margin="15,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0 0 32">

                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <toolkitGrid:DataGrid
                            x:Name="AreasGrid"
                            AutoGenerateColumns="False"
                            DataContext="{x:Bind AreaViewModel}"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsHitTestVisible="True"
                            IsReadOnly="True"
                            IsTabStop="False"
                            ItemsSource="{x:Bind AreaViewModel.Areas}"
                            SelectedItem="{x:Bind AreaViewModel.SelectedArea, Mode=TwoWay}"
                            SelectionMode="Single">

                            <toolkitGrid:DataGrid.ColumnHeaderStyle>
                                <Style TargetType="primitives:DataGridColumnHeader">
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimMedium}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                                                <Grid Background="{ThemeResource SystemAccentColor}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Content="{TemplateBinding Content}"
                                                        Foreground="White" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </toolkitGrid:DataGrid.ColumnHeaderStyle>

                            <toolkitGrid:DataGrid.CellStyle>
                                <Style TargetType="toolkitGrid:DataGridCell">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimFD}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </toolkitGrid:DataGrid.CellStyle>

                            <toolkitGrid:DataGrid.RowStyle>
                                <Style TargetType="toolkitGrid:DataGridRow">
                                    <Setter Property="MinHeight" Value="44" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </toolkitGrid:DataGrid.RowStyle>

                            <toolkitGrid:DataGrid.Columns>

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="SizeToCells"
                                    MinWidth="52"
                                    Header="ردیف">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding Converter={StaticResource RowIndexConverter}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding AreaName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="نام حوزه" />

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding UpdatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="آخرین ویرایش توسط" />

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ویرایش">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding UpdatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding CreatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="ایجاد شده توسط" />

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ایجاد">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding CreatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTemplateColumn Width="90" Header="عملیات">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Area">
                                            <Button
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnAreaDeleteClick"
                                                DataContext="{Binding}">

                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="Red"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                            </toolkitGrid:DataGrid.Columns>

                        </toolkitGrid:DataGrid>

                        <localControls:PaginationControl
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            CurrentPage="{x:Bind AreaViewModel.CurrentPage, Mode=TwoWay}"
                            FlowDirection="LeftToRight"
                            PageChangedCommand="{x:Bind AreaViewModel.PageChangedCommand}"
                            PageSize="5"
                            TotalItemCount="{x:Bind AreaViewModel.TotalAreas, Mode=OneWay}" />

                    </Grid>
                </Border>
            </Grid>
        </TabViewItem>

        <TabViewItem Header="ثبت نوع مکان های اندازه گیری" IsClosable="False">
            <TabViewItem.Resources>
                <converters:RowIndexConverter
                    x:Key="RowIndexConverter"
                    CurrentPage="{x:Bind LocationTypeViewModel.CurrentPage, Mode=OneWay}"
                    ItemsSource="{x:Bind LocationTypeViewModel.LocationTypes, Mode=OneWay}"
                    PageSize="5" />
            </TabViewItem.Resources>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    MaxWidth="400"
                    Margin="20,10"
                    HorizontalAlignment="Left"
                    Orientation="Vertical">
                    <TextBox
                        Name="TitleBox"
                        MinWidth="300"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Header="نوع مکان اندازه گیری"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="لطفاً نوع مکان مورد نظر را وارد کنید"
                        Text="{x:Bind LocationTypeViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Height="70"
                    Margin="20,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Name="BtnAddLocationType"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind LocationTypeViewModel.AddLocationTypeCommand}"
                        Content="{x:Bind LocationTypeViewModel.AddEditBtnContent, Mode=OneWay}"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Name="BtnClearTitleBox"
                        Width="80"
                        HorizontalAlignment="Left"
                        Command="{x:Bind LocationTypeViewModel.ClearFormCommand}"
                        Content="پاک کردن"
                        FontFamily="{StaticResource SamimMedium}"
                        IsEnabled="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <InfoBar
                        x:Name="TitleBoxInfoBar"
                        VerticalAlignment="Center"
                        IsClosable="False"
                        IsOpen="{x:Bind LocationTypeViewModel.IsErrorVisible, Mode=TwoWay}"
                        Message="{x:Bind LocationTypeViewModel.InfoBarMessage, Mode=OneWay}"
                        Severity="{x:Bind LocationTypeViewModel.InfoBarSeverity, Mode=OneWay}" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    MaxWidth="1100"
                    Margin="15,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0 0 32">

                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <toolkitGrid:DataGrid
                            x:Name="LocationTypesGrid"
                            AutoGenerateColumns="False"
                            DataContext="{x:Bind LocationTypeViewModel}"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsHitTestVisible="True"
                            IsReadOnly="True"
                            IsTabStop="False"
                            ItemsSource="{x:Bind LocationTypeViewModel.LocationTypes}"
                            SelectedItem="{x:Bind LocationTypeViewModel.SelectedLocationType, Mode=TwoWay}"
                            SelectionMode="Single">

                            <toolkitGrid:DataGrid.ColumnHeaderStyle>
                                <Style TargetType="primitives:DataGridColumnHeader">
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimMedium}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                                                <Grid Background="{ThemeResource SystemAccentColor}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Content="{TemplateBinding Content}"
                                                        Foreground="White" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </toolkitGrid:DataGrid.ColumnHeaderStyle>

                            <toolkitGrid:DataGrid.CellStyle>
                                <Style TargetType="toolkitGrid:DataGridCell">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontFamily" Value="{StaticResource SamimFD}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </toolkitGrid:DataGrid.CellStyle>

                            <toolkitGrid:DataGrid.RowStyle>
                                <Style TargetType="toolkitGrid:DataGridRow">
                                    <Setter Property="MinHeight" Value="44" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </toolkitGrid:DataGrid.RowStyle>

                            <toolkitGrid:DataGrid.Columns>

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="SizeToCells"
                                    MinWidth="52"
                                    Header="ردیف">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding Converter={StaticResource RowIndexConverter}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding Title}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="نوع مکان" />

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding UpdatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="آخرین ویرایش توسط" />

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ویرایش">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding UpdatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTextColumn
                                    Width="SizeToCells"
                                    MinWidth="150"
                                    Binding="{Binding CreatedBy.FullName}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}"
                                    Header="ایجاد شده توسط" />

                                <toolkitGrid:DataGridTemplateColumn
                                    Width="150"
                                    MinWidth="150"
                                    Header="زمان ایجاد">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding CreatedAt, Converter={StaticResource DateTimeToShamsiDisplayConv}}" />
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                                <toolkitGrid:DataGridTemplateColumn Width="90" Header="عملیات">
                                    <toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LocationType">
                                            <Button
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnLocTypeDeleteClick"
                                                DataContext="{Binding}">

                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="Red"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </DataTemplate>
                                    </toolkitGrid:DataGridTemplateColumn.CellTemplate>
                                </toolkitGrid:DataGridTemplateColumn>

                            </toolkitGrid:DataGrid.Columns>

                        </toolkitGrid:DataGrid>

                        <localControls:PaginationControl
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            CurrentPage="{x:Bind LocationTypeViewModel.CurrentPage, Mode=TwoWay}"
                            FlowDirection="LeftToRight"
                            PageChangedCommand="{x:Bind LocationTypeViewModel.PageChangedCommand}"
                            PageSize="5"
                            TotalItemCount="{x:Bind LocationTypeViewModel.TotalLocationTypes, Mode=OneWay}" />
                    </Grid>
                </Border>

            </Grid>
        </TabViewItem>
    </TabView>
</Page>