<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WaterAssessment.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource ContentControlThemeFontFamily}"
    mc:Ignorable="d">

    <Grid>

        <!--  Background  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0F2027" />
                <GradientStop Offset="0.5" Color="#203A43" />
                <GradientStop Offset="1" Color="#2C5364" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  Login Card  -->
        <Border
            Width="420"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource SystemControlAcrylicWindowBrush}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="20"
            Translation="0 0 38">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="20">

                <!--  Title  -->
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="48"
                        Foreground="{StaticResource HydroSecondary}"
                        Glyph="&#xEB42;" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource SamimMedium}"
                        FontSize="22"
                        Text="سامانه جامع محاسبات هیدرومتری" />
                </StackPanel>

                <!--  Username  -->
                <StackPanel Spacing="5">
                    <TextBlock Text="نام کاربری" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            Background="#22000000"
                            CornerRadius="8,0,0,8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Glyph="&#xE77B;" />
                        </Border>

                        <TextBox
                            Grid.Column="1"
                            Height="45"
                            CornerRadius="0,8,8,0"
                            KeyDown="OnEnterPressed"
                            PlaceholderText="نام کاربری"
                            Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <!--  Password  -->
                <StackPanel Spacing="5">
                    <TextBlock Text="رمز عبور" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="#22000000"
                            CornerRadius="8,0,0,8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Glyph="&#xE72E;" />
                        </Border>

                        <PasswordBox
                            x:Name="TxtPassword"
                            Grid.Column="1"
                            Height="45"
                            CornerRadius="0,8,8,0"
                            KeyDown="OnEnterPressed"
                            PlaceholderText="رمز عبور" />
                    </Grid>
                </StackPanel>

                <!--  Login Button  -->
                <Button
                    Height="45"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.LoginCommand}"
                    CommandParameter="{x:Bind TxtPassword}"
                    Content="ورود به سامانه"
                    CornerRadius="10"
                    FontFamily="{StaticResource SamimMedium}"
                    Style="{ThemeResource AccentButtonStyle}" />

                <!--  Loading  -->
                <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!--  Error  -->
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
